# Only needed for hosted mode. Export variables in your shell; never commit secrets.
IRONCLAD_API_KEY=
IRONCLAD_MODEL=
IRONCLAD_API_URL=https://api.openai.com/v1/chat/completions
# Set verified provider prices, per million tokens. Required; no guessed prices.
IRONCLAD_INPUT_USD_PER_MILLION=
IRONCLAD_OUTPUT_USD_PER_MILLION=

# Required for dashboard sign-in: use at least 24 random characters.
IRONCLAD_ADMIN_TOKEN=
# API and worker must share these paths.
IRONCLAD_DB=.ironclad/events.db
IRONCLAD_REPO=examples/broken_repo
# Compose host path (absolute recommended).
IRONCLAD_REPO_HOST=./examples/broken_repo
# For a TLS reverse proxy only:
IRONCLAD_SECURE_COOKIE=0
# Draft PR integration; one repository, no auto-merge.
IRONCLAD_GITHUB_REPO=
IRONCLAD_GITHUB_TOKEN=
IRONCLAD_WEBHOOK_SECRET=
# Optional production extras: pip install -e '.[production]'
IRONCLAD_DATABASE_URL=
IRONCLAD_REDIS_URL=
IRONCLAD_POSTGRES_PASSWORD=
IRONCLAD_EMBEDDING_KEY=
IRONCLAD_EMBEDDING_MODEL=
IRONCLAD_EMBEDDING_DIMENSIONS=1536
IRONCLAD_EMBEDDING_USD_PER_MILLION=
IRONCLAD_EMBEDDING_URL=https://api.openai.com/v1/embeddings
IRONCLAD_OTLP_ENDPOINT=

# Optional when the local target is a subdirectory of the GitHub repository.
IRONCLAD_REPO_SUBDIR=
